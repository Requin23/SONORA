# Base de donnees Postgres (ex: Neon, Supabase, Railway...)
DATABASE_URL=

# YengaPay - console.yengapay.com (app.yengapay.com) > votre projet PayIn
YENGAPAY_GROUP_ID=
YENGAPAY_PROJECT_ID=
YENGAPAY_API_KEY=
# "test" pendant le developpement, "prod" une fois pret a encaisser reellement
YENGAPAY_ENV=test
# Secret partage a configurer aussi cote console YengaPay pour valider les webhooks
YENGAPAY_WEBHOOK_SECRET=

# URL publique de l'app (utile si tu veux la reference dans la console YengaPay
# pour configurer l'URL de redirection post-paiement)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Affiche un bouton de simulation de webhook sur la page de paiement (dev only)
# IMPORTANT : mettre a "false" en production.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true

# Acces a /admin (Basic Auth). Choisis un mot de passe fort en production.
# Compte 1 (obligatoire)
ADMIN_USER=admin
ADMIN_PASSWORD=
# Compte 2 (optionnel) - laisser vide si un seul admin suffit
ADMIN_USER_2=
ADMIN_PASSWORD_2=

# Notifications email (Resend - https://resend.com, cle API dans le dashboard)
# Sans RESEND_API_KEY/EMAIL_FROM, les emails sont juste loggues en console (dev).
RESEND_API_KEY=
EMAIL_FROM="Sonora <onboarding@resend.dev>"
# Emails des admins qui recoivent une notif a chaque nouvelle commande (virgule)
ADMIN_NOTIFICATION_EMAILS=
